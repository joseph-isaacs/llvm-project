# RUN: llc -mtriple=aarch64 -mcpu=cortex-a510 -run-pass=early-ifcvt -o - %s | FileCheck %s

# Diamond from rust-lang/rust#162074: %bb.1 divides by a constant (34 cycle
# critical path on this model), %bb.2 uses two dependent sdivs (45 cycles).
# Whether speculating both is worth it depends on how often each leg runs:
# the leg that executes pays for waiting on the other one.

--- |
  define i64 @unbiased(i64 %value, i64 %numerator, i64 %denom) { ret i64 0 }
  define i64 @sdiv_leg_hot(i64 %value, i64 %numerator, i64 %denom) { ret i64 0 }
  define i64 @sdiv_leg_cold(i64 %value, i64 %numerator, i64 %denom) { ret i64 0 }
...
# An unbiased branch: the constant leg would wait 11 cycles for the sdivs
# half of the time, more than half the misprediction penalty. Keep the branch.
# CHECK-LABEL: name: unbiased
# CHECK-NOT:     CSELXr
# CHECK:         Bcc
# CHECK-NOT:     CSELXr
---
name:            unbiased
tracksRegLiveness: true
liveins:
  - { reg: '$x0', virtual-reg: '%4' }
  - { reg: '$x2', virtual-reg: '%6' }
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $x0, $x2
  
    %6:gpr64 = COPY $x2
    %4:gpr64 = COPY $x0
    %7:gpr32 = MOVi32imm 1000000000
    %0:gpr64 = SUBREG_TO_REG killed %7, %subreg.sub_32
    %8:gpr32 = MOVi32imm 24000000
    %9:gpr64 = SUBREG_TO_REG killed %8, %subreg.sub_32
    %10:gpr64 = SUBSXrr %6, killed %9, implicit-def $nzcv
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1
  
  bb.1:
    successors: %bb.3(0x80000000)
  
    %18:gpr64 = MOVi64imm -5551535331153507085
    %19:gpr64 = SMULHrr %4, %18
    %20:gpr64 = ADDXrr killed %19, %4
    %21:gpr64 = SBFMXri %20, 24, 63
    %22:gpr64 = ADDXrs killed %21, %20, 127
    %23:gpr32 = MOVi32imm 24000000
    %24:gpr64 = SUBREG_TO_REG killed %23, %subreg.sub_32
    %26:gpr64 = MSUBXrrr %22, killed %24, %4
    %27:gpr64 = nsw MADDXrrr killed %26, %0, $xzr
    %29:gpr64 = SMULHrr %27, %18
    %30:gpr64 = ADDXrr killed %29, %27
    %31:gpr64 = SBFMXri %30, 24, 63
    %32:gpr64 = ADDXrs killed %31, %30, 127
    %33:gpr64 = MADDXrrr %22, %0, killed %32
    %1:gpr64all = COPY %33
    B %bb.3
  
  bb.2:
    successors: %bb.3(0x80000000)
  
    %11:gpr64 = SDIVXr %4, %6
    %13:gpr64 = MSUBXrrr %11, %6, %4
    %14:gpr64 = MADDXrrr killed %13, %0, $xzr
    %16:gpr64 = SDIVXr killed %14, %6
    %17:gpr64 = MADDXrrr %11, %0, killed %16
    %2:gpr64all = COPY %17
  
  bb.3:
    %3:gpr64all = PHI %2, %bb.2, %1, %bb.1
    $x0 = COPY %3
    RET_ReallyLR implicit $x0
...
# The sdiv leg runs 90% of the time. The rarely taken constant leg is the only
# one that gets slower, and a branch this biased is rarely mispredicted, but the
# weighted cost still fits the budget. Convert.
# CHECK-LABEL: name: sdiv_leg_hot
# CHECK-NOT:     Bcc
# CHECK:         CSELXr
---
name:            sdiv_leg_hot
tracksRegLiveness: true
liveins:
  - { reg: '$x0', virtual-reg: '%4' }
  - { reg: '$x2', virtual-reg: '%6' }
body:             |
  bb.0:
    successors: %bb.1(0x0ccccccd), %bb.2(0x73333333)
    liveins: $x0, $x2
  
    %6:gpr64 = COPY $x2
    %4:gpr64 = COPY $x0
    %7:gpr32 = MOVi32imm 1000000000
    %0:gpr64 = SUBREG_TO_REG killed %7, %subreg.sub_32
    %8:gpr32 = MOVi32imm 24000000
    %9:gpr64 = SUBREG_TO_REG killed %8, %subreg.sub_32
    %10:gpr64 = SUBSXrr %6, killed %9, implicit-def $nzcv
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1
  
  bb.1:
    successors: %bb.3(0x80000000)
  
    %18:gpr64 = MOVi64imm -5551535331153507085
    %19:gpr64 = SMULHrr %4, %18
    %20:gpr64 = ADDXrr killed %19, %4
    %21:gpr64 = SBFMXri %20, 24, 63
    %22:gpr64 = ADDXrs killed %21, %20, 127
    %23:gpr32 = MOVi32imm 24000000
    %24:gpr64 = SUBREG_TO_REG killed %23, %subreg.sub_32
    %26:gpr64 = MSUBXrrr %22, killed %24, %4
    %27:gpr64 = nsw MADDXrrr killed %26, %0, $xzr
    %29:gpr64 = SMULHrr %27, %18
    %30:gpr64 = ADDXrr killed %29, %27
    %31:gpr64 = SBFMXri %30, 24, 63
    %32:gpr64 = ADDXrs killed %31, %30, 127
    %33:gpr64 = MADDXrrr %22, %0, killed %32
    %1:gpr64all = COPY %33
    B %bb.3
  
  bb.2:
    successors: %bb.3(0x80000000)
  
    %11:gpr64 = SDIVXr %4, %6
    %13:gpr64 = MSUBXrrr %11, %6, %4
    %14:gpr64 = MADDXrrr killed %13, %0, $xzr
    %16:gpr64 = SDIVXr killed %14, %6
    %17:gpr64 = MADDXrrr %11, %0, killed %16
    %2:gpr64all = COPY %17
  
  bb.3:
    %3:gpr64all = PHI %2, %bb.2, %1, %bb.1
    $x0 = COPY %3
    RET_ReallyLR implicit $x0
...
# The constant leg runs 90% of the time and would pay the full 11 cycles on
# almost every execution. Keep the branch.
# CHECK-LABEL: name: sdiv_leg_cold
# CHECK-NOT:     CSELXr
# CHECK:         Bcc
# CHECK-NOT:     CSELXr
---
name:            sdiv_leg_cold
tracksRegLiveness: true
liveins:
  - { reg: '$x0', virtual-reg: '%4' }
  - { reg: '$x2', virtual-reg: '%6' }
body:             |
  bb.0:
    successors: %bb.1(0x73333333), %bb.2(0x0ccccccd)
    liveins: $x0, $x2
  
    %6:gpr64 = COPY $x2
    %4:gpr64 = COPY $x0
    %7:gpr32 = MOVi32imm 1000000000
    %0:gpr64 = SUBREG_TO_REG killed %7, %subreg.sub_32
    %8:gpr32 = MOVi32imm 24000000
    %9:gpr64 = SUBREG_TO_REG killed %8, %subreg.sub_32
    %10:gpr64 = SUBSXrr %6, killed %9, implicit-def $nzcv
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1
  
  bb.1:
    successors: %bb.3(0x80000000)
  
    %18:gpr64 = MOVi64imm -5551535331153507085
    %19:gpr64 = SMULHrr %4, %18
    %20:gpr64 = ADDXrr killed %19, %4
    %21:gpr64 = SBFMXri %20, 24, 63
    %22:gpr64 = ADDXrs killed %21, %20, 127
    %23:gpr32 = MOVi32imm 24000000
    %24:gpr64 = SUBREG_TO_REG killed %23, %subreg.sub_32
    %26:gpr64 = MSUBXrrr %22, killed %24, %4
    %27:gpr64 = nsw MADDXrrr killed %26, %0, $xzr
    %29:gpr64 = SMULHrr %27, %18
    %30:gpr64 = ADDXrr killed %29, %27
    %31:gpr64 = SBFMXri %30, 24, 63
    %32:gpr64 = ADDXrs killed %31, %30, 127
    %33:gpr64 = MADDXrrr %22, %0, killed %32
    %1:gpr64all = COPY %33
    B %bb.3
  
  bb.2:
    successors: %bb.3(0x80000000)
  
    %11:gpr64 = SDIVXr %4, %6
    %13:gpr64 = MSUBXrrr %11, %6, %4
    %14:gpr64 = MADDXrrr killed %13, %0, $xzr
    %16:gpr64 = SDIVXr killed %14, %6
    %17:gpr64 = MADDXrrr %11, %0, killed %16
    %2:gpr64all = COPY %17
  
  bb.3:
    %3:gpr64all = PHI %2, %bb.2, %1, %bb.1
    $x0 = COPY %3
    RET_ReallyLR implicit $x0
...
