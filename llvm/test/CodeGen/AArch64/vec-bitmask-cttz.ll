; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=aarch64 -mattr=+neon -verify-machineinstrs < %s | FileCheck %s

; Finding the first set lane of a compare result via cttz of the packed
; bitmask should use a 64-bit scalar view of the mask (SHRN #4 nibble mask
; for 128-bit compares) instead of materializing the packed bitmask.

define i32 @first_match_v16i8(<16 x i8> %a, <16 x i8> %b) {
; CHECK-LABEL: first_match_v16i8:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmeq v0.16b, v0.16b, v1.16b
; CHECK-NEXT:    shrn v0.8b, v0.8h, #4
; CHECK-NEXT:    fmov x8, d0
; CHECK-NEXT:    rbit x8, x8
; CHECK-NEXT:    clz x8, x8
; CHECK-NEXT:    lsr x0, x8, #2
; CHECK-NEXT:    // kill: def $w0 killed $w0 killed $x0
; CHECK-NEXT:    ret
  %cmp = icmp eq <16 x i8> %a, %b
  %mask = bitcast <16 x i1> %cmp to i16
  %ext = zext i16 %mask to i32
  %idx = call i32 @llvm.cttz.i32(i32 %ext, i1 true)
  ret i32 %idx
}

; cttz with defined zero behaviour: an all-zero mask must give 16.
define i16 @first_match_v16i8_zero_defined(<16 x i8> %a, <16 x i8> %b) {
; CHECK-LABEL: first_match_v16i8_zero_defined:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmeq v0.16b, v0.16b, v1.16b
; CHECK-NEXT:    shrn v0.8b, v0.8h, #4
; CHECK-NEXT:    fmov x8, d0
; CHECK-NEXT:    rbit x8, x8
; CHECK-NEXT:    clz x8, x8
; CHECK-NEXT:    lsr x0, x8, #2
; CHECK-NEXT:    // kill: def $w0 killed $w0 killed $x0
; CHECK-NEXT:    ret
  %cmp = icmp eq <16 x i8> %a, %b
  %mask = bitcast <16 x i1> %cmp to i16
  %idx = call i16 @llvm.cttz.i16(i16 %mask, i1 false)
  ret i16 %idx
}

; A zero-defined cttz of the *extended* mask must not be combined: a zero
; mask would have to produce 32, not 16.
define i32 @first_match_v16i8_zext_zero_defined(<16 x i8> %a, <16 x i8> %b) {
; CHECK-LABEL: first_match_v16i8_zext_zero_defined:
; CHECK:       // %bb.0:
; CHECK-NEXT:    adrp x8, .LCPI2_0
; CHECK-NEXT:    cmeq v0.16b, v0.16b, v1.16b
; CHECK-NEXT:    ldr q1, [x8, :lo12:.LCPI2_0]
; CHECK-NEXT:    and v0.16b, v0.16b, v1.16b
; CHECK-NEXT:    addp v0.16b, v0.16b, v0.16b
; CHECK-NEXT:    addp v0.16b, v0.16b, v0.16b
; CHECK-NEXT:    addp v0.16b, v0.16b, v0.16b
; CHECK-NEXT:    umov w8, v0.h[0]
; CHECK-NEXT:    rbit w8, w8
; CHECK-NEXT:    clz w0, w8
; CHECK-NEXT:    ret
  %cmp = icmp eq <16 x i8> %a, %b
  %mask = bitcast <16 x i1> %cmp to i16
  %ext = zext i16 %mask to i32
  %idx = call i32 @llvm.cttz.i32(i32 %ext, i1 false)
  ret i32 %idx
}

