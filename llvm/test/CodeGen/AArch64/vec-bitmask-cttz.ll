; The guarding mask != 0 test and the cttz should share one scalar view of
; the mask (a single shrn + fmov).
define i32 @first_match_v16i8_guarded(<16 x i8> %a, <16 x i8> %b) {
; CHECK-LABEL: first_match_v16i8_guarded:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmeq v0.16b, v0.16b, v1.16b
; CHECK-NEXT:    shrn v0.8b, v0.8h, #4
; CHECK-NEXT:    fmov x8, d0
; CHECK-NEXT:    rbit x9, x8
; CHECK-NEXT:    cmp x8, #0
; CHECK-NEXT:    clz x9, x9
; CHECK-NEXT:    lsr x9, x9, #2
; CHECK-NEXT:    csinv w0, w9, wzr, ne
; CHECK-NEXT:    ret
  %cmp = icmp eq <16 x i8> %a, %b
  %mask = bitcast <16 x i1> %cmp to i16
  %any = icmp ne i16 %mask, 0
  %ext = zext i16 %mask to i32
  %idx = call i32 @llvm.cttz.i32(i32 %ext, i1 true)
  %res = select i1 %any, i32 %idx, i32 -1
  ret i32 %res
}

declare i16 @llvm.cttz.i16(i16, i1)
declare i32 @llvm.cttz.i32(i32, i1)
