; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -S -passes=bitmask-lowering -mtriple=x86_64-- < %s | FileCheck %s

; The compare->bitmask idiom in its various vectorized shapes should collapse to
; a single `bitcast <N x i1> to iN` (which the x86 backend lowers to a movemask).

declare i8 @llvm.vector.reduce.or.v8i8(<8 x i8>)
declare i32 @llvm.vector.reduce.or.v8i32(<8 x i32>)
declare i64 @llvm.vector.reduce.or.v64i64(<64 x i64>)
declare i8 @llvm.vector.reduce.add.v8i8(<8 x i8>)
declare i8 @llvm.vector.reduce.xor.v8i8(<8 x i8>)

; select %m, <1,2,4,...,128>, zeroinitializer  ->  bitcast to i8
define i8 @select_form_i8(<8 x i1> %m) {
; CHECK-LABEL: @select_form_i8(
; CHECK-NEXT:    [[R:%.*]] = bitcast <8 x i1> [[M:%.*]] to i8
; CHECK-NEXT:    ret i8 [[R]]
;
  %sel = select <8 x i1> %m, <8 x i8> <i8 1, i8 2, i8 4, i8 8, i8 16, i8 32, i8 64, i8 -128>, <8 x i8> zeroinitializer
  %r = call i8 @llvm.vector.reduce.or.v8i8(<8 x i8> %sel)
  ret i8 %r
}

; Wider element type: bitcast to i8, then zext to i32.
define i32 @select_form_i32(<8 x i1> %m) {
; CHECK-LABEL: @select_form_i32(
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast <8 x i1> [[M:%.*]] to i8
; CHECK-NEXT:    [[R:%.*]] = zext i8 [[TMP1]] to i32
; CHECK-NEXT:    ret i32 [[R]]
;
  %sel = select <8 x i1> %m, <8 x i32> <i32 1, i32 2, i32 4, i32 8, i32 16, i32 32, i32 64, i32 128>, <8 x i32> zeroinitializer
  %r = call i32 @llvm.vector.reduce.or.v8i32(<8 x i32> %sel)
  ret i32 %r
}

; shl (zext %m), <0,1,2,...,7>
define i8 @shl_form_i8(<8 x i1> %m) {
; CHECK-LABEL: @shl_form_i8(
; CHECK-NEXT:    [[R:%.*]] = bitcast <8 x i1> [[M:%.*]] to i8
; CHECK-NEXT:    ret i8 [[R]]
;
  %z = zext <8 x i1> %m to <8 x i8>
  %shl = shl <8 x i8> %z, <i8 0, i8 1, i8 2, i8 3, i8 4, i8 5, i8 6, i8 7>
  %r = call i8 @llvm.vector.reduce.or.v8i8(<8 x i8> %shl)
  ret i8 %r
}

; and (sext %m), <1,2,4,...,128>
define i8 @and_form_i8(<8 x i1> %m) {
; CHECK-LABEL: @and_form_i8(
; CHECK-NEXT:    [[R:%.*]] = bitcast <8 x i1> [[M:%.*]] to i8
; CHECK-NEXT:    ret i8 [[R]]
;
  %s = sext <8 x i1> %m to <8 x i8>
  %and = and <8 x i8> %s, <i8 1, i8 2, i8 4, i8 8, i8 16, i8 32, i8 64, i8 -128>
  %r = call i8 @llvm.vector.reduce.or.v8i8(<8 x i8> %and)
  ret i8 %r
}

; mul (zext %m), <1,2,4,...,128>
define i8 @mul_form_i8(<8 x i1> %m) {
; CHECK-LABEL: @mul_form_i8(
; CHECK-NEXT:    [[R:%.*]] = bitcast <8 x i1> [[M:%.*]] to i8
; CHECK-NEXT:    ret i8 [[R]]
;
  %z = zext <8 x i1> %m to <8 x i8>
  %mul = mul <8 x i8> %z, <i8 1, i8 2, i8 4, i8 8, i8 16, i8 32, i8 64, i8 -128>
  %r = call i8 @llvm.vector.reduce.or.v8i8(<8 x i8> %mul)
  ret i8 %r
}

; reduce.add is equivalent because the lane contributions are disjoint bits.
define i8 @add_reduce_i8(<8 x i1> %m) {
; CHECK-LABEL: @add_reduce_i8(
; CHECK-NEXT:    [[R:%.*]] = bitcast <8 x i1> [[M:%.*]] to i8
; CHECK-NEXT:    ret i8 [[R]]
;
  %sel = select <8 x i1> %m, <8 x i8> <i8 1, i8 2, i8 4, i8 8, i8 16, i8 32, i8 64, i8 -128>, <8 x i8> zeroinitializer
  %r = call i8 @llvm.vector.reduce.add.v8i8(<8 x i8> %sel)
  ret i8 %r
}

; reduce.xor is likewise equivalent.
define i8 @xor_reduce_i8(<8 x i1> %m) {
; CHECK-LABEL: @xor_reduce_i8(
; CHECK-NEXT:    [[R:%.*]] = bitcast <8 x i1> [[M:%.*]] to i8
; CHECK-NEXT:    ret i8 [[R]]
;
  %sel = select <8 x i1> %m, <8 x i8> <i8 1, i8 2, i8 4, i8 8, i8 16, i8 32, i8 64, i8 -128>, <8 x i8> zeroinitializer
  %r = call i8 @llvm.vector.reduce.xor.v8i8(<8 x i8> %sel)
  ret i8 %r
}

