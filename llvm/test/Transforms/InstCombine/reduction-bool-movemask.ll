; Reductions over per-lane bit-position weights of a bool mask are a
; compare->bitmask ("movemask") bit-pack: lane i of the mask becomes bit i of
; the scalar result. Fold them to `zext(bitcast <N x i1> to iN)`. The lane->bit
; mapping of the bitcast only holds on little-endian targets, so the fold is
; suppressed for big-endian data layouts.

declare void @use(<8 x i8>)

; select %m, <1,2,4,...,128>, zeroinitializer  ->  bitcast to i8
define i8 @select_form_i8(<8 x i1> %m) {
; CHECK-LABEL: @select_form_i8(
; CHECK-NEXT:    [[SEL:%.*]] = select <8 x i1> [[M:%.*]], <8 x i8> <i8 1, i8 2, i8 4, i8 8, i8 16, i8 32, i8 64, i8 -128>, <8 x i8> zeroinitializer
; CHECK-NEXT:    [[R:%.*]] = call i8 @llvm.vector.reduce.or.v8i8(<8 x i8> [[SEL]])
; CHECK-NEXT:    ret i8 [[R]]
;
  %sel = select <8 x i1> %m, <8 x i8> <i8 1, i8 2, i8 4, i8 8, i8 16, i8 32, i8 64, i8 -128>, <8 x i8> zeroinitializer
  %r = call i8 @llvm.vector.reduce.or.v8i8(<8 x i8> %sel)
  ret i8 %r
}

