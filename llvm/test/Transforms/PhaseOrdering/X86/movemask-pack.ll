; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %empty = icmp eq i64 %chunks, 0
  br i1 %empty, label %exit, label %outer

outer:
  %chunk = phi i64 [ %chunk.next, %latch ], [ 0, %entry ]
  %base = shl i64 %chunk, 6
  br label %inner

inner:
  %bit = phi i64 [ 0, %outer ], [ %bit.next, %inner ]
  %packed = phi i64 [ 0, %outer ], [ %packed.next, %inner ]
  %i = add i64 %base, %bit
  %g = getelementptr i8, ptr %data, i64 %i
  %v = load i8, ptr %g, align 1
  %c = icmp ne i8 %v, 0
  %z = zext i1 %c to i64
  %s = shl i64 %z, %bit
  %packed.next = or i64 %packed, %s
  %bit.next = add nuw nsw i64 %bit, 1
  %done = icmp eq i64 %bit.next, 64
  br i1 %done, label %latch, label %inner

latch:
  %og = getelementptr i64, ptr %out, i64 %chunk
  store i64 %packed.next, ptr %og, align 8
  %chunk.next = add nuw i64 %chunk, 1
  %outer.done = icmp eq i64 %chunk.next, %chunks
  br i1 %outer.done, label %exit, label %outer

exit:
  ret void
}
