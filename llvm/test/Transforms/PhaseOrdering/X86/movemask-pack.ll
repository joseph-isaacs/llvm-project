; CHECK-NEXT:    [[BASE:%.*]] = shl i64 [[CHUNK]], 6
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr i8, ptr [[DATA:%.*]], i64 [[BASE]]
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[TMP0]], i64 4
