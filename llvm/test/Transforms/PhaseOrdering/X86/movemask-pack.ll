; CHECK-NEXT:    [[DOTNOT26:%.*]] = icmp eq <4 x i8> [[WIDE_LOAD4_3]], zeroinitializer
; CHECK-NEXT:    [[DOTNOT27:%.*]] = icmp eq <4 x i8> [[WIDE_LOAD5_3]], zeroinitializer
